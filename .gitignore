# Publish source/examples/tests/docs only. Runtime and owner data stay local.
/*
!/.gitignore
!/.gitattributes
!/AGENTS.md
!/README.md
!/requirements.txt
!/test_*.py
!/run_regression.py
!/tunnel_setup.py
!/stock_monitor/
!/docs/
/stock_monitor/*
!/stock_monitor/*.py
!/stock_monitor/requirements.txt
!/stock_monitor/config.example.json
!/stock_monitor/cp_experience_catalogue.json
!/stock_monitor/ui_messages.json

# Private historical fixtures: retain locally; never publish owner paths/data.
/test_admission_expiry.py
/test_closed_period_scope.py
/test_health_readiness_meaning.py
/test_prior_review_binding.py
/test_seed_proof_status.py
/stock_monitor/test_demo_all_warmup.py

# Defence in depth, also for future subdirectories.
**/__pycache__/
*.py[cod]
*.sqlite*
*.db
*.db-*
*.wal
*.shm
*.log
*.jsonl
*.csv
*.parquet
*.pkl
*.pickle
*.zip
*.7z
*.exe
*.dll
*.prof
.env
.env.*
!.env.example
**/config.json
**/distribution.json
**/bridge.json
**/private/
**/profiles/
**/test-data/
**/history64-evidence/
**/test-tmp/
**/data-copies/
**/outputs/
**/runtime-tcl/
**/.venv/
**/venv/
**/*token*.txt
**/*key*.txt
**/*secret*

# Sanitized, explicit publication documentation only.
/docs/*
!/docs/*.md
!/docs/publication_manifest.json
!/docs/regression_results.json
